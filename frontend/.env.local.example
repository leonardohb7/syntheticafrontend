# Copie este arquivo para .env.local antes de rodar o portal:
#   Windows:  copy .env.local.example .env.local
#   Linux:    cp .env.local.example .env.local
#
# Endereço da API FastAPI do portal.
# O prefixo NEXT_PUBLIC_ é obrigatório: sem ele o Next não expõe a variável ao
# navegador, e as chamadas do portal acontecem todas no cliente.
#
# Desenvolvimento: o backend local do uvicorn.
# Deploy: a URL pública da API no Render.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
